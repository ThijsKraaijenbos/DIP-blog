---
// One layout for every post. Everything comes from the post's frontmatter;
// the post body (your text) goes in the <slot />.
import { getImage, Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LaserHero from '@/components/layout/LaserHero.astro';
import Tag from '@/components/ui/Tag.astro';
import Verdict from '@/components/post/Verdict.astro';
import Sources from '@/components/post/Sources.astro';
import PostCTA from '@/components/post/PostCTA.astro';
import RelatedPosts from '@/components/post/RelatedPosts.astro';
import { SITE, CATEGORIES } from '@/consts';
import { themeStyle } from '@/themes';
import { formatDate, readTime, type Post } from '@/utils/posts';

interface Props { post: Post; related: Post[]; newer?: Post; older?: Post }
const { post, related, newer, older } = Astro.props;
const d = post.data;

// Social preview: the hero image cropped to 1200×630.
const og = await getImage({ src: d.heroImage.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
// Optional phrase in the title shown in the atmosphere colour (frontmatter `titleAccent`).
const accentAt = d.titleAccent ? d.title.indexOf(d.titleAccent) : -1;
const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: new URL(og.src, Astro.site ?? SITE.url).href,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: new URL('/about/', Astro.site ?? SITE.url).href },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: url,
  articleSection: CATEGORIES[d.category],
  keywords: d.tags.join(', ') || undefined,
};
---
<BaseLayout
  title={d.metaTitle ?? d.title} description={d.description} type="article"
  image={og.src} imageAlt={d.heroImage.alt}
  publishedTime={d.pubDate} modifiedTime={d.updatedDate} jsonLd={jsonLd}
>
  <article style={themeStyle(d.theme)}>
    {/* Hero image sits behind the header. Small labels (date row, tags) get a solid black backing so they keep AA contrast over the photo. */}
    <LaserHero>
      <Image
        slot="bg" src={d.heroImage.src} alt={d.heroImage.alt} widths={[800, 1200, 1600, 2000]} sizes="100vw"
        loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover"
      />
      <header class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <p class="meta -mx-2 flex w-fit flex-wrap items-center gap-x-4 gap-y-2 bg-bg px-2 py-1">
          <a href="/blog/" class="!text-atmo-text no-underline hover:underline">{CATEGORIES[d.category]}</a>
          <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
          {d.updatedDate && <span>Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></span>}
          <span>{readTime(post.body)}</span>
        </p>
        <h1 class="mt-4 max-w-5xl text-4xl">
          {accentAt >= 0 && d.titleAccent ? (
            <>{d.title.slice(0, accentAt)}<span class="text-atmo-text">{d.titleAccent}</span>{d.title.slice(accentAt + d.titleAccent.length)}</>
          ) : d.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-fg sm:text-xl">{d.intro}</p>
        {(d.persona || d.genre || d.tags.length > 0) && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            {d.persona && <span class="inline-flex min-h-6 items-center border border-line-strong bg-bg px-2 font-mono text-xs uppercase tracking-wider text-muted">For: {d.persona}</span>}
            {d.genre && <Tag tag={d.genre} />}
            {d.tags.filter((t) => t !== d.genre).map((t) => <Tag tag={t} />)}
          </div>
        )}
        <p class="mt-10 flex max-w-4xl flex-wrap items-baseline gap-x-4 gap-y-1 text-xs text-muted">
          <span>{d.heroImage.caption}</span>
          <span class="font-mono">{d.heroImage.creditUrl ? <a href={d.heroImage.creditUrl} rel="noopener" target="_blank" class="underline">{d.heroImage.credit}</a> : d.heroImage.credit}</span>
        </p>
      </header>
    </LaserHero>

    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-[68ch]">
        <div class="post-body mt-10"><slot /></div>
        {d.verdict && <Verdict scores={d.verdict.scores} summary={d.verdict.summary} />}
        <Sources sources={d.sources} />
        <PostCTA newer={newer} older={older} />
      </div>

      <div class="max-w-4xl"><RelatedPosts posts={related} /></div>
    </div>
  </article>
</BaseLayout>
