---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeatureHero from '@/components/layout/FeatureHero.astro';
import CommunityCTA from '@/components/ui/CommunityCTA.astro';
import PostCard from '@/components/ui/PostCard.astro';
import Button from '@/components/ui/Button.astro';
import NewsletterForm from '@/components/post/NewsletterForm.astro';
import { SITE, CATEGORIES, NEWSLETTER_ENABLED, COMMUNITY } from '@/consts';
import { CTA_COPY } from '@/data/copy';
import { getPosts, postUrl, readTime } from '@/utils/posts';
const latest = (await getPosts()).slice(0, 4);
const newest = latest[0];
const hero = CTA_COPY.hero;
// Structured data so Google knows the site's name and who writes it.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url + '/',
  description: SITE.description,
  inLanguage: SITE.locale,
  author: { '@type': 'Person', name: SITE.author, url: SITE.url + '/about/' },
};
---
<BaseLayout jsonLd={jsonLd}>
  <FeatureHero
    title={SITE.tagline} compact
    facts={[['Genres', 'Uptempo'], ['', 'Raw'], ['', 'Zaag'], ['Scene', 'NL hardcore']]}
  >
    {/* One action above the fold: the newest post once there is one, until then the newsletter. */}
    {newest ? (
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href={postUrl(newest)}>{newest.data.category === 'review' ? hero.latestReview : hero.latestPost}</Button>
        {NEWSLETTER_ENABLED && <a href="/about/#newsletter">{hero.emailLink}</a>}
      </div>
    ) : NEWSLETTER_ENABLED && (
      <div>
        <p class="mb-3 font-mono text-sm uppercase tracking-wider text-fg">{hero.newsletter}</p>
        <NewsletterForm bare />
      </div>
    )}
  </FeatureHero>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="mt-16 max-w-prose" aria-labelledby="about-title">
      <h2 id="about-title" class="text-3xl">Why Kickback exists</h2>
      <p class="mt-4">Kickback is my blog about uptempo and rawstyle raves and festivals in the Netherlands. Here I'll write honest reviews based on my own experience, including how much a festival actually cost me and whether it was worth the money in my opinion. Additionally I'll share tips for people who are new to the scene. For example how you can hear the difference between the genres and what to bring to your first big festival. Feel free to follow me on <a href={COMMUNITY.instagram} rel="noopener" target="_blank">Instagram</a> or <a href={COMMUNITY.tiktok} rel="noopener" target="_blank">TikTok</a> if you want to share your own thoughts!</p>
      <p class="mt-4"><a href="/about/">More about me &amp; Kickback</a></p>
    </section>
    <section id="reviews" class="mt-16 border-t border-line pt-8" aria-labelledby="reviews-title">
      <h2 id="reviews-title" class="text-3xl">Latest posts</h2>
      {latest.length === 0 ? (
        <p class="mt-4 max-w-prose text-muted">The first reviews are being written. Check back after the next weekend out.</p>
      ) : (
        <>
          <ul class="mt-6 max-w-4xl space-y-4">
            {latest.map((p) => (
              <li>
                <PostCard
                  href={postUrl(p)} title={p.data.title} description={p.data.description} date={p.data.pubDate}
                  category={CATEGORIES[p.data.category]} genre={p.data.genre} readTime={readTime(p.body)} theme={p.data.theme}
                />
              </li>
            ))}
          </ul>
          <div class="mt-6"><Button href="/blog/" variant="secondary">All posts</Button></div>
        </>
      )}
    </section>
    <section id="community" class="mt-16 border-y border-atmo py-8" aria-label="Community"><CommunityCTA /></section>
  </div>
</BaseLayout>
