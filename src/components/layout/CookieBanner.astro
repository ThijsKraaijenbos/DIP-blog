---
// GA4 only loads after the visitor says yes (EU cookie rules). The choice is stored in
// localStorage. "Cookie settings" in the footer reopens this bar.
// Vercel Web Analytics is cookieless, so it doesn't need this.
interface Props { id: string }
const { id } = Astro.props;
---
<div
  id="cookie-bar" hidden role="region" aria-label="Cookie choice"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-atmo bg-surface"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <p class="max-w-prose text-sm text-fg">
      Can I use Google Analytics cookies to see which posts people read? No ads, no selling data.{' '}
      <a href="/privacy/">Privacy</a>
    </p>
    <div class="flex gap-2">
      <button type="button" data-consent="denied" class="min-h-11 rounded-xs border border-line-strong px-4 font-mono text-sm uppercase tracking-wider text-fg hover:border-fg">No thanks</button>
      <button type="button" data-consent="granted" class="min-h-11 rounded-xs border border-cta bg-cta px-4 font-mono text-sm font-bold uppercase tracking-wider text-cta-ink hover:border-fg hover:bg-fg">Allow</button>
    </div>
  </div>
</div>
<script is:inline define:vars={{ id }}>
  const KEY = 'kickback-consent';
  const bar = document.getElementById('cookie-bar');
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const save = (v) => { try { localStorage.setItem(KEY, v); } catch {} };
  let loaded = false;
  function loadGA() {
    if (loaded) return;
    loaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', id, { anonymize_ip: true });
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
    document.head.appendChild(s);
  }
  const choice = read();
  if (choice === 'granted') loadGA();
  else if (choice !== 'denied') bar.hidden = false;
  bar.addEventListener('click', (e) => {
    const v = e.target.closest('[data-consent]')?.dataset.consent;
    if (!v) return;
    save(v);
    bar.hidden = true;
    if (v === 'granted') loadGA();
    else if (loaded) location.reload(); // stop GA if it was running
  });
  document.querySelector('[data-cookie-settings]')?.addEventListener('click', () => { bar.hidden = false; });
</script>
