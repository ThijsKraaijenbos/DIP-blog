---
// 1px "laser" divider in the atmosphere colour, optionally with a small sigil mark.
import Sigil from '@/components/ui/Sigil.astro';
interface Props { mark?: boolean; class?: string }
const { mark = true, class: className = '' } = Astro.props;
---
<div class:list={['flex items-center gap-3', className]} role="separator">
  <span class="h-px flex-1 bg-atmo"></span>
  {mark && <Sigil size={20} />}
  <span class="h-px flex-1 bg-atmo"></span>
</div>
