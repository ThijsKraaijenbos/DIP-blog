---
// Hero for the home page / post header, laid out like a flyer: the title runs huge on the
// left, the event facts sit in a stacked "lineup" block beside it, one CTA below.
// Pass `href` for a button, or put your own CTA in the slot (the home page does this).
import LaserHero from '@/components/layout/LaserHero.astro';
import Button from '@/components/ui/Button.astro';
interface Props { title: string; facts?: [string, string][]; href?: string; cta?: string; compact?: boolean; sweep?: boolean; as?: 'h1' | 'h2' }
const { title, facts = [], href, cta = 'Read the review', compact = false, sweep = true, as: H = 'h1' } = Astro.props;
---
<LaserHero sweep={sweep}>
  <div class:list={['mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 md:grid-cols-[1fr_auto] md:items-end', compact ? 'py-12' : 'py-16 sm:py-24']}>
    <div>
      <H class:list={['max-w-4xl', compact ? 'text-4xl' : 'text-5xl']}>{title}</H>
      {href && <div class="mt-8"><Button href={href}>{cta}</Button></div>}
      {Astro.slots.has('default') && <div class="mt-8"><slot /></div>}
    </div>
    {facts.length > 0 && (
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 border-t border-atmo pt-3 md:min-w-56">
        {facts.map(([k, v]) => (
          <>
            <dt class="font-mono text-xs uppercase leading-7 text-subtle">{k}</dt>
            <dd class="font-display text-xl uppercase leading-7">{v}</dd>
          </>
        ))}
      </dl>
    )}
  </div>
</LaserHero>
