---
// Hero with flat SVG lasers behind the content: a few hand-placed beams from three
// fixtures, like a real stage rig. One slow sweep, off under reduced motion.
// Optional `bg` slot: a photo behind everything, darkened by a flat 80% black layer so text keeps AA contrast.
interface Props { class?: string; sweep?: boolean }
const { class: className = '', sweep = true } = Astro.props;
// [x1, y1, x2, y2] in a 1000×600 box; fixtures sit above the top edge.
const rig = [
  { origin: '940px -30px', beams: [[940, -30, 120, 620], [940, -30, 410, 620], [940, -30, 560, 640], [940, -30, 1020, 380]] },
  { origin: '610px -40px', beams: [[610, -40, -40, 300], [610, -40, 260, 640], [610, -40, 900, 640]] },
];
const accent = [1000, 120, 330, 640]; // the single red beam, low and from the side
const hasBg = Astro.slots.has('bg');
---
<section class:list={['relative overflow-hidden border-b border-line', className]}>
  {hasBg && <slot name="bg" />}
  {hasBg && <div class="absolute inset-0 bg-bg/80" aria-hidden="true"></div>}
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1000 600"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    {rig.map((f, i) => (
      <g class:list={[sweep && (i === 0 ? 'laser-sweep' : 'laser-sweep-rev')]} style={`transform-origin:${f.origin}`}>
        {f.beams.map(([x1, y1, x2, y2]) => (
          <line {x1} {y1} {x2} {y2} stroke="var(--atmo)" stroke-width="1" vector-effect="non-scaling-stroke" opacity="0.6" />
        ))}
      </g>
    ))}
    <line x1={accent[0]} y1={accent[1]} x2={accent[2]} y2={accent[3]} stroke="var(--atmo-text)" stroke-width="1" vector-effect="non-scaling-stroke" opacity="0.9" />
  </svg>
  <div class="relative">
    <slot />
  </div>
</section>
<style>
  .laser-sweep { animation: sweep var(--duration-sweep) ease-in-out infinite alternate; }
  .laser-sweep-rev { animation: sweep var(--duration-sweep) ease-in-out infinite alternate-reverse; animation-duration: 19s; }
  @keyframes sweep { from { transform: rotate(-3deg); } to { transform: rotate(3deg); } }
  @media (prefers-reduced-motion: reduce) { .laser-sweep, .laser-sweep-rev { animation: none; } }
</style>
