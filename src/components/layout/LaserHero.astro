---
// Hero with a flat SVG laser fan behind the content. Lasers are thin flat lines
// (atmosphere colour + a few red beams). One slow sweep, off under reduced motion.
interface Props { class?: string; sweep?: boolean }
const { class: className = '', sweep = true } = Astro.props;
const ORIGIN = [880, -20];
const beams = Array.from({ length: 15 }, (_, i) => {
  const x = -200 + i * 90;
  const red = i === 3 || i === 9;
  return { x, red };
});
---
<section class:list={['relative overflow-hidden border-b border-line', className]}>
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1000 600"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <g class:list={[sweep && 'laser-sweep']} style={`transform-origin:${ORIGIN[0]}px ${ORIGIN[1]}px`}>
      {beams.map((b) => (
        <line
          x1={ORIGIN[0]} y1={ORIGIN[1]} x2={b.x} y2="620"
          stroke={b.red ? 'var(--color-action)' : 'var(--atmo)'}
          stroke-width="1" vector-effect="non-scaling-stroke"
          opacity={b.red ? 0.9 : 0.55}
        />
      ))}
    </g>
  </svg>
  <div class="relative">
    <slot />
  </div>
</section>
<style>
  .laser-sweep { animation: sweep var(--duration-sweep) ease-in-out infinite alternate; }
  @keyframes sweep { from { transform: rotate(-3deg); } to { transform: rotate(3deg); } }
  @media (prefers-reduced-motion: reduce) { .laser-sweep { animation: none; } }
</style>
