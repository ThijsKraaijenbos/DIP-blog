---
// TikTok video that only loads after the reader clicks (privacy: no TikTok cookies before that).
// `url` is the normal video link from the browser address bar: https://www.tiktok.com/@user/video/1234567890123456789
// (short vm.tiktok.com links don't work: open them first and copy the long URL). `label` describes the video for
// screen readers, `credit` names the maker, `creditUrl` (optional) links to them. Optional caption between the tags.
import SocialEmbed from './SocialEmbed.astro';
interface Props { url: string; label: string; credit: string; creditUrl?: string; class?: string }
const { url, ...rest } = Astro.props;
const id = url.match(/^https:\/\/(?:www\.|m\.)?tiktok\.com\/@[\w.-]+\/video\/(\d+)/)?.[1];
if (!id) throw new Error(`TikTokEmbed: "${url}" is not a TikTok video URL. Use the full link, like https://www.tiktok.com/@user/video/1234567890123456789`);
---
<SocialEmbed platform="TikTok" embedSrc={`https://www.tiktok.com/player/v1/${id}?rel=0`} {url} {...rest}><slot /></SocialEmbed>
