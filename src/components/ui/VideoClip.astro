---
// Short self-hosted clip with caption + credit, styled like Figure.astro.
// Files live in public/videos/ (Astro does not optimize video), so `src` and `poster` are plain paths like "/videos/clip.mp4".
// `label` describes the clip for screen readers. The caption goes between the tags (it may contain links).
// Clips keep their sound and only play when the reader presses play. Sized for portrait (9:16) phone clips.
// Smaller download: put an AV1 copy next to the clip as `<name>-av1.mp4` (see README). Browsers that can play AV1
// (Chrome, Edge, Firefox, Android, newer iPhones/Macs) download that one; everything else gets the normal .mp4.
// Too loud? Lower the audio in the file itself (README → "Adding a short video"); that works on every device, iPhones included.
// To show it next to a section's text on desktop, wrap that section in <MediaSection> (src/components/post/MediaSection.astro).
import { existsSync } from 'node:fs';
interface Props {
  src: string; poster: string; label: string; credit: string; creditUrl?: string;
  width?: number; height?: number; class?: string;
}
const { src, poster, label, credit, creditUrl, width = 540, height = 960, class: className = '' } = Astro.props;
const av1 = src.replace(/\.mp4$/, '-av1.mp4');
const hasAv1 = av1 !== src && existsSync(`public${av1}`);
---
<figure class:list={['mx-auto w-full max-w-[360px] border border-line', className]}>
  <video
    poster={poster} aria-label={label} width={width} height={height}
    controls playsinline preload="metadata"
    class="block h-auto w-full bg-bg"
  >
    {hasAv1 && <source src={av1} type='video/mp4; codecs="av01.0.04M.08"' />}
    <source src={src} type="video/mp4" />
    <a href={src}>Download the clip</a>
  </video>
  <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-line px-3 py-2">
    <div class="text-sm text-fg [&_p]:m-0"><slot /></div>
    <span class="font-mono text-xs text-muted">{creditUrl ? <a href={creditUrl} rel="noopener" target="_blank">{credit}</a> : credit}</span>
  </figcaption>
</figure>
