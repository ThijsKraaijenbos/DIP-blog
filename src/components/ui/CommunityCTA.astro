---
// Community call-to-action: one button (WhatsApp group), Discord as a plain link.
// Without group links it falls back to Instagram (red button) or TikTok (outline button).
// Texts live in src/data/copy.ts.
import Button from '@/components/ui/Button.astro';
import { COMMUNITY } from '@/consts';
import { CTA_COPY } from '@/data/copy';
interface Props { as?: 'h2' | 'h3' }
const { as: H = 'h2' } = Astro.props;
const c = CTA_COPY.community;
---
<div class="@container">
  <H class="text-3xl">{c.title}</H>
  {c.text && <p class="mt-3 max-w-prose text-muted">{c.text}</p>}
  <div class="mt-6 flex flex-col items-start gap-3 @xl:flex-row @xl:items-center @xl:gap-x-6">
    {COMMUNITY.whatsapp
      ? <Button href={COMMUNITY.whatsapp} external>{c.button}</Button>
      : <Button href={COMMUNITY.instagram} external>{c.followButton}</Button>}
    {COMMUNITY.discord
      ? <a href={COMMUNITY.discord} rel="noopener" target="_blank">{c.secondary}</a>
      : (
        <>
          <span class="meta">{c.followOr}</span>
          <Button href={COMMUNITY.tiktok} variant="secondary" external>{c.followSecondary}</Button>
        </>
      )}
  </div>
</div>
