---
// Community call-to-action: one primary action (Discord), secondary WhatsApp, small notify box.
import Button from '@/components/ui/Button.astro';
import Sigil from '@/components/ui/Sigil.astro';
import { COMMUNITY } from '@/consts';
---
<section class="relative overflow-hidden border border-line-strong bg-surface p-6 sm:p-8" aria-labelledby="cta-title">
  <Sigil tone="watermark" size={260} class="pointer-events-none absolute -bottom-16 -right-16" />
  <div class="relative">
    <p class="meta !text-atmo-text">Join the crew</p>
    <h2 id="cta-title" class="mt-2 text-3xl">Going to the next one?</h2>
    <p class="mt-3 max-w-prose text-muted">Find people to rave with, swap outfit ideas and get set times first in the Discord.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href={COMMUNITY.discord} external>Join the Discord</Button>
      <Button href={COMMUNITY.whatsapp} variant="secondary" external>WhatsApp group</Button>
    </div>
    <form class="mt-8 max-w-md border-t border-line pt-6" action="#" method="post">
      <label for="notify-email" class="meta block">Get notified of new posts (optional)</label>
      <div class="mt-2 flex">
        <input id="notify-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com"
          class="min-h-11 min-w-0 flex-1 rounded-none border border-line-strong bg-bg px-3 font-mono text-sm text-fg placeholder:text-subtle" />
        <button type="submit" class="min-h-11 border border-l-0 border-line-strong px-4 font-mono text-sm uppercase text-fg hover:bg-fg hover:text-bg">Notify me</button>
      </div>
    </form>
  </div>
</section>
