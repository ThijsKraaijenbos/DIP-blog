---
// Community call-to-action in the owner's voice: one button (Discord), WhatsApp as a plain link.
import Button from '@/components/ui/Button.astro';
import { COMMUNITY } from '@/consts';
---
<section class="border-y border-atmo py-8" aria-labelledby="cta-title">
  <h2 id="cta-title" class="text-3xl">Rave with us</h2>
  <p class="mt-3 max-w-prose text-muted">I post set times, meetup spots and lost-and-found in the Discord before every event. Come say hi, and bring your crew.</p>
  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
    <Button href={COMMUNITY.discord} external>Join the Discord</Button>
    <a href={COMMUNITY.whatsapp} rel="noopener" target="_blank">or the WhatsApp group</a>
  </div>
</section>
