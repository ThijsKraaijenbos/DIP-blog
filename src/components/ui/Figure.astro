---
// Image with caption + credit line (credits are graded, so both are required).
// `credit` is the full line, e.g. "Photo: own photo" or "Image generated with ChatGPT (OpenAI, 2026)".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata; alt: string; caption: string; credit: string; creditUrl?: string;
  class?: string; priority?: boolean; sizes?: string;
}
const { src, alt, caption, credit, creditUrl, class: className = '', priority = false, sizes = '(min-width: 768px) 768px, 100vw' } = Astro.props;
---
<figure class:list={['border border-line', className]}>
  <Image
    src={src} alt={alt} widths={[480, 800, 1200, 1600]} {sizes}
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'}
    class="block h-auto w-full"
  />
  <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-line px-3 py-2">
    <span class="text-sm text-fg">{caption}</span>
    <span class="font-mono text-xs text-muted">{creditUrl ? <a href={creditUrl} rel="noopener" target="_blank">{credit}</a> : credit}</span>
  </figcaption>
</figure>
