---
// Image with caption + credit (credits are graded, so both are required).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption: string; credit: string; creditUrl?: string; class?: string }
const { src, alt, caption, credit, creditUrl, class: className = '' } = Astro.props;
---
<figure class:list={['border border-line', className]}>
  <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 768px, 100vw" class="block h-auto w-full" />
  <figcaption class="flex flex-wrap justify-between gap-x-4 gap-y-1 border-t border-line px-3 py-2">
    <span class="text-sm text-fg">{caption}</span>
    <span class="meta">Photo: {creditUrl ? <a href={creditUrl} rel="noopener" target="_blank">{credit}</a> : credit}</span>
  </figcaption>
</figure>
