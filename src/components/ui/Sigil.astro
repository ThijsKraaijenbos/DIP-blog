---
// The KB icon (Kickback's mark), drawn inline so it can take the theme colour.
// Same artwork as public/brand/kickback-icon.svg. `size` is the height in px.
import { KB_ICON_PATH } from '@/components/ui/kb-icon-path';
interface Props {
  size?: number;
  /** 'atmo' = theme colour, 'fg' = off-white, 'watermark' = dark low-contrast */
  tone?: 'atmo' | 'fg' | 'watermark';
  class?: string;
  label?: string; // omit for decorative use (aria-hidden)
}
const { size = 64, tone = 'atmo', class: className = '', label } = Astro.props;
const color = { atmo: 'var(--atmo)', fg: 'var(--color-fg)', watermark: '#1a1919' }[tone];
---
<svg
  viewBox="0 0 699 793"
  height={size}
  width={Math.round((size * 699) / 793)}
  class={className}
  fill={color}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
><path fill-rule="evenodd" clip-rule="evenodd" d={KB_ICON_PATH} /></svg>
