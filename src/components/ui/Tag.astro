---
// Tag chip. Every tag takes the current atmosphere colour (the post's theme), so a post never shows
// several tag colours at once. The genre colours (uptempo, rawstyle, rawtempo) are themes a whole post can use.
interface Props { tag: string; href?: string }
const { tag, href } = Astro.props;
const El = href ? 'a' : 'span';
---
<El
  href={href}
  class="inline-flex min-h-6 items-center border border-atmo bg-bg px-2 font-mono text-xs uppercase tracking-wider text-atmo-text no-underline hover:bg-atmo hover:text-bg"
>#{tag}</El>
