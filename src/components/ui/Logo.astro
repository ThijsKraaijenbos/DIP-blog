---
// The Kickback logo (custom wordmark, UV violet). Source files live in public/brand/.
// The colour is fixed: themes never change the logo.
import { SITE } from '@/consts';
interface Props { size?: 'sm' | 'lg'; class?: string }
const { size = 'sm', class: className = '' } = Astro.props;
// The SVG is 1921×793, so width = height × 2.42.
const h = size === 'lg' ? 120 : 52;
---
<img
  src="/brand/kickback-logo.svg"
  alt={SITE.name}
  width={Math.round(h * 2.42)}
  height={h}
  class:list={['block h-auto', size === 'lg' ? 'w-[290px]' : 'w-[132px] sm:w-[176px]', className]}
/>
